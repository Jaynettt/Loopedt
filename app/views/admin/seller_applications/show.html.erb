
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Review Seller Application | Loopedt</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f5f6f2;
      color: #263d32;
      font-family: Arial, sans-serif;
    }

    .admin-layout {
      display: flex;
      min-height: 100vh;
    }

    /* SIDEBAR */

    .sidebar {
      width: 245px;
      background: #244e3b;
      color: white;
      padding: 30px 20px;
      flex-shrink: 0;
    }

    .brand {
      font-size: 28px;
      font-weight: bold;
      letter-spacing: -1px;
      margin-bottom: 10px;
    }

    .admin-label {
      font-size: 11px;
      color: #c3d5c9;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 45px;
    }

    .nav-heading {
      color: #a9c2b2;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin: 25px 0 12px;
    }

    .sidebar a {
      display: block;
      color: #e8f0eb;
      text-decoration: none;
      padding: 13px 14px;
      border-radius: 8px;
      font-size: 14px;
      margin-bottom: 7px;
    }

    .sidebar a:hover,
    .sidebar a.active {
      background: #37634d;
      color: white;
    }

    .sidebar-footer {
      margin-top: 60px;
      padding-top: 20px;
      border-top: 1px solid #496c58;
    }

    /* MAIN CONTENT */

    .main-content {
      flex: 1;
      min-width: 0;
      padding: 35px 4%;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 30px;
    }

    .topbar h1 {
      margin: 0 0 8px;
      color: #244e3b;
      font-size: 27px;
    }

    .topbar p {
      margin: 0;
      color: #849087;
      font-size: 14px;
    }

    .back-link {
      display: inline-block;
      padding: 11px 16px;
      background: white;
      border: 1px solid #e5eae4;
      color: #244e3b;
      border-radius: 7px;
      text-decoration: none;
      font-size: 13px;
      font-weight: bold;
    }

    /* STATUS */

    .status {
      display: inline-block;
      padding: 7px 13px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: bold;
      text-transform: capitalize;
    }

    .status-pending {
      background: #fff2d9;
      color: #a46b10;
    }

    .status-approved {
      background: #e1f2e8;
      color: #277044;
    }

    .status-rejected {
      background: #fbe8e6;
      color: #b34a40;
    }

    /* APPLICATION CONTENT */

    .review-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 22px;
      align-items: start;
    }

    .panel {
      background: white;
      border: 1px solid #e9ece7;
      border-radius: 13px;
      padding: 26px;
      margin-bottom: 22px;
    }

    .panel h2 {
      font-size: 18px;
      color: #244e3b;
      margin: 0 0 22px;
    }

    .detail-row {
      padding: 17px 0;
      border-bottom: 1px solid #f0f2ef;
    }

    .detail-row:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .detail-label {
      display: block;
      font-size: 11px;
      color: #929b94;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 8px;
    }

    .detail-value {
      font-size: 14px;
      color: #244e3b;
      font-weight: 600;
      overflow-wrap: anywhere;
    }

    .description {
      font-weight: normal;
      color: #56645b;
      line-height: 1.7;
    }

    /* REVIEW PANEL */

    .decision-panel {
      background: white;
      border: 1px solid #e9ece7;
      border-radius: 13px;
      padding: 24px;
      position: sticky;
      top: 25px;
    }

    .decision-panel h2 {
      margin: 0 0 10px;
      color: #244e3b;
      font-size: 18px;
    }

    .decision-panel > p {
      color: #849087;
      font-size: 13px;
      line-height: 1.6;
      margin-bottom: 22px;
    }

    .decision-button {
      width: 100%;
      display: block;
      padding: 13px;
      border: none;
      border-radius: 7px;
      font-size: 13px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 12px;
    }

    .approve-button {
      background: #244e3b;
      color: white;
    }

    .approve-button:hover {
      background: #37634d;
    }

    .reject-button {
      background: #fbe8e6;
      color: #b34a40;
    }

    .reject-button:hover {
      background: #f5d8d5;
    }

    .decision-note {
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid #edf0ec;
      color: #929b94;
      font-size: 12px;
      line-height: 1.6;
    }

    .already-reviewed {
      padding: 15px;
      border-radius: 8px;
      background: #f5f7f4;
      color: #56645b;
      font-size: 13px;
      line-height: 1.6;
    }

    @media (max-width: 950px) {
      .review-grid {
        grid-template-columns: 1fr;
      }

      .decision-panel {
        position: static;
      }
    }

    @media (max-width: 650px) {
      .admin-layout {
        display: block;
      }

      .sidebar {
        width: 100%;
        padding: 20px;
      }

      .admin-label {
        margin-bottom: 20px;
      }

      .sidebar-footer {
        margin-top: 20px;
      }

      .main-content {
        padding: 25px 18px;
      }

      .topbar {
        align-items: flex-start;
        flex-direction: column;
      }

      .panel {
        padding: 20px;
      }
    }
  </style>
</head>

<body>

<div class="admin-layout">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="brand">loopedt.</div>
    <div class="admin-label">Administration</div>

    <div class="nav-heading">Workspace</div>

    <a href="<%= admin_root_path %>">▦ &nbsp; Dashboard</a>

    <a href="<%= admin_seller_applications_path %>" class="active">
      ♙ &nbsp; Seller Applications
    </a>

    <div class="nav-heading">Storefront</div>

    <a href="<%= listings_path %>">⌂ &nbsp; View Marketplace</a>

    <div class="sidebar-footer">
      <a href="/">← &nbsp; Back to Loopedt</a>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">

    <div class="topbar">
      <div>
        <h1>Review Application</h1>
        <p>Review the seller's information before making a decision.</p>
      </div>

      <%= link_to "← All Applications",
          admin_seller_applications_path,
          class: "back-link" %>
    </div>

    <div class="review-grid">

      <!-- APPLICATION DETAILS -->
      <div>

        <section class="panel">
          <h2>Applicant Information</h2>

          <div class="detail-row">
            <span class="detail-label">Full Name / Username</span>
            <div class="detail-value">
              <%= @application.user.username %>
            </div>
          </div>

          <div class="detail-row">
            <span class="detail-label">Email Address</span>
            <div class="detail-value">
              <%= @application.user.email %>
            </div>
          </div>

          <div class="detail-row">
            <span class="detail-label">Application Date</span>
            <div class="detail-value">
              <%= @application.created_at.strftime("%d %B %Y at %I:%M %p") %>
            </div>
          </div>
        </section>

        <section class="panel">
          <h2>Shop Information</h2>

          <div class="detail-row">
            <span class="detail-label">Shop Name</span>
            <div class="detail-value">
              <%= @application.shop_name %>
            </div>
          </div>

          <div class="detail-row">
            <span class="detail-label">Shop Location</span>
            <div class="detail-value">
              <%= @application.location.presence || "Not provided" %>
            </div>
          </div>

          <div class="detail-row">
            <span class="detail-label">Shop Description</span>
            <div class="detail-value description">
              <%= @application.description.presence || "No description provided." %>
            </div>
          </div>
        </section>

      </div>

      <!-- DECISION PANEL -->
      <aside class="decision-panel">

        <h2>Application Status</h2>

        <p>Current status of this seller application.</p>

        <span class="status status-<%= @application.status %>">
          <%= @application.status %>
        </span>

        <% if @application.status == "pending" %>

          <div class="decision-note">
            Review the applicant's information carefully before making your decision.
          </div>

          <%= button_to "✓ Approve Application",
              admin_seller_application_path(@application),
              method: :patch,
              params: { status: "approved" },
              class: "decision-button approve-button" %>

          <%= button_to "✕ Reject Application",
              admin_seller_application_path(@application),
              method: :patch,
              params: { status: "rejected" },
              class: "decision-button reject-button" %>

        <% else %>

          <div class="already-reviewed">
            This application has already been <strong><%= @application.status %></strong>.
            No further action is currently available.
          </div>

        <% end %>

      </aside>

    </div>

  </main>

</div>

</body>
</html>
