
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Dashboard | Loopedt</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f5f6f2;
      color: #263d32;
      font-family: Arial, sans-serif;
    }

    .admin-layout {
      display: flex;
      min-height: 100vh;
    }

    /* SIDEBAR */

    .sidebar {
      width: 245px;
      background: #244e3b;
      color: white;
      padding: 30px 20px;
      flex-shrink: 0;
    }

    .brand {
      font-size: 28px;
      font-weight: bold;
      margin-bottom: 10px;
      letter-spacing: -1px;
    }

    .admin-label {
      font-size: 11px;
      color: #c3d5c9;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 45px;
    }

    .nav-heading {
      color: #a9c2b2;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin: 25px 0 12px;
    }

    .sidebar a {
      display: block;
      color: #e8f0eb;
      text-decoration: none;
      padding: 13px 14px;
      border-radius: 8px;
      font-size: 14px;
      margin-bottom: 7px;
      transition: 0.2s;
    }

    .sidebar a:hover,
    .sidebar a.active {
      background: #37634d;
      color: white;
    }

    .sidebar-footer {
      margin-top: 60px;
      padding-top: 20px;
      border-top: 1px solid #496c58;
    }

    /* MAIN CONTENT */

    .main-content {
      flex: 1;
      min-width: 0;
      padding: 35px 4%;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 35px;
    }

    .topbar h1 {
      margin: 0 0 7px;
      font-size: 27px;
      color: #244e3b;
    }

    .topbar p {
      margin: 0;
      color: #849087;
      font-size: 14px;
    }

    .admin-profile {
      background: white;
      border: 1px solid #e8ebe6;
      border-radius: 30px;
      padding: 10px 17px;
      font-size: 13px;
      color: #244e3b;
    }

    /* SUMMARY CARDS */

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-bottom: 35px;
    }

    .stat-card {
      background: white;
      padding: 23px;
      border-radius: 13px;
      border: 1px solid #e9ece7;
      box-shadow: 0 3px 12px rgba(0,0,0,0.025);
    }

    .stat-label {
      font-size: 13px;
      color: #849087;
      margin-bottom: 15px;
    }

    .stat-number {
      font-size: 32px;
      font-weight: bold;
      color: #244e3b;
      margin-bottom: 8px;
    }

    .stat-description {
      font-size: 12px;
      color: #9aa39c;
    }

    .stat-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      margin-bottom: 17px;
    }

    .icon-total {
      background: #e9f1eb;
    }

    .icon-pending {
      background: #fff2d9;
    }

    .icon-approved {
      background: #e1f2e8;
    }

    .icon-rejected {
      background: #fbe8e6;
    }

    /* CONTENT PANELS */

    .panel {
      background: white;
      border: 1px solid #e9ece7;
      border-radius: 13px;
      padding: 25px;
      margin-bottom: 25px;
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 22px;
    }

    .panel-header h2 {
      font-size: 18px;
      margin: 0;
      color: #244e3b;
    }

    .view-all {
      color: #244e3b;
      font-size: 13px;
      font-weight: bold;
      text-decoration: none;
    }

    .view-all:hover {
      text-decoration: underline;
    }

    /* TABLE */

    .table-wrapper {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 600px;
    }

    th {
      text-align: left;
      padding: 13px 12px;
      font-size: 11px;
      color: #929b94;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      border-bottom: 1px solid #edf0ec;
    }

    td {
      padding: 17px 12px;
      font-size: 13px;
      border-bottom: 1px solid #f0f2ef;
      color: #56645b;
    }

    tr:last-child td {
      border-bottom: none;
    }

    .applicant-name {
      font-weight: bold;
      color: #244e3b;
      margin-bottom: 5px;
    }

    .applicant-email {
      font-size: 12px;
      color: #929b94;
    }

    .status {
      display: inline-block;
      padding: 6px 11px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: bold;
      text-transform: capitalize;
    }

    .status-pending {
      background: #fff2d9;
      color: #a46b10;
    }

    .status-approved {
      background: #e1f2e8;
      color: #277044;
    }

    .status-rejected {
      background: #fbe8e6;
      color: #b34a40;
    }

    .action-link {
      color: #244e3b;
      text-decoration: none;
      font-weight: bold;
      font-size: 12px;
    }

    .empty-state {
      text-align: center;
      padding: 35px 15px;
      color: #929b94;
      font-size: 14px;
    }

    /* QUICK ACTIONS */

    .quick-actions {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }

    .quick-action {
      display: flex;
      align-items: center;
      gap: 15px;
      padding: 19px;
      background: #f8faf7;
      border: 1px solid #e9eee9;
      border-radius: 10px;
      text-decoration: none;
      color: #244e3b;
      transition: 0.2s;
    }

    .quick-action:hover {
      background: #edf4ee;
      border-color: #cbdccf;
    }

    .quick-action-icon {
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #e5eee7;
      border-radius: 10px;
      font-size: 19px;
    }

    .quick-action strong {
      display: block;
      font-size: 13px;
      margin-bottom: 5px;
    }

    .quick-action span {
      font-size: 11px;
      color: #89958c;
    }

    /* RESPONSIVE */

    @media (max-width: 1000px) {
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 650px) {
      .admin-layout {
        display: block;
      }

      .sidebar {
        width: 100%;
        padding: 20px;
      }

      .admin-label {
        margin-bottom: 20px;
      }

      .sidebar-footer {
        margin-top: 20px;
      }

      .main-content {
        padding: 25px 18px;
      }

      .topbar {
        align-items: flex-start;
        flex-direction: column;
      }

      .stats-grid,
      .quick-actions {
        grid-template-columns: 1fr;
      }

      .panel {
        padding: 18px;
      }
    }
  </style>
</head>

<body>

<div class="admin-layout">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="brand">loopedt.</div>
    <div class="admin-label">Administration</div>

    <div class="nav-heading">Workspace</div>

    <a href="/admin" class="active">▦ &nbsp; Dashboard</a>

    <a href="<%= admin_seller_applications_path %>">
      ♙ &nbsp; Seller Applications
    </a>

    <div class="nav-heading">Storefront</div>

    <a href="<%= listings_path %>">⌂ &nbsp; View Marketplace</a>

    <div class="sidebar-footer">
      <a href="/">← &nbsp; Back to Loopedt</a>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">

    <div class="topbar">
      <div>
        <h1>Dashboard Overview</h1>
        <p>Welcome to your Loopedt administration panel.</p>
      </div>

      <div class="admin-profile">
        Administrator
      </div>
    </div>

    <!-- SUMMARY CARDS -->
    <section class="stats-grid">

      <div class="stat-card">
        <div class="stat-icon icon-total">▦</div>
        <div class="stat-label">Total Applications</div>
        <div class="stat-number"><%= @total_applications %></div>
        <div class="stat-description">All seller applications received</div>
      </div>

      <div class="stat-card">
        <div class="stat-icon icon-pending">◷</div>
        <div class="stat-label">Pending Review</div>
        <div class="stat-number"><%= @pending_applications %></div>
        <div class="stat-description">Applications awaiting a decision</div>
      </div>

      <div class="stat-card">
        <div class="stat-icon icon-approved">✓</div>
        <div class="stat-label">Approved Sellers</div>
        <div class="stat-number"><%= @approved_applications %></div>
        <div class="stat-description">Successfully approved applications</div>
      </div>

      <div class="stat-card">
        <div class="stat-icon icon-rejected">✕</div>
        <div class="stat-label">Rejected Applications</div>
        <div class="stat-number"><%= @rejected_applications %></div>
        <div class="stat-description">Applications not approved</div>
      </div>

    </section>

    <!-- RECENT APPLICATIONS -->
    <section class="panel">

      <div class="panel-header">
        <h2>Recent Seller Applications</h2>

        <%= link_to "View all applications →",
            admin_seller_applications_path,
            class: "view-all" %>
      </div>

      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Applicant</th>
              <th>Shop Name</th>
              <th>Location</th>
              <th>Date Submitted</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>
            <% if @recent_applications.any? %>

              <% @recent_applications.each do |application| %>
                <tr>
                  <td>
                    <div class="applicant-name">
                      <%= application.user.username %>
                    </div>

                    <div class="applicant-email">
                      <%= application.user.email %>
                    </div>
                  </td>

                  <td><%= application.shop_name %></td>

                  <td><%= application.location.presence || "Not provided" %></td>

                  <td><%= application.created_at.strftime("%d %b %Y") %></td>

                  <td>
                    <span class="status status-<%= application.status %>">
                      <%= application.status %>
                    </span>
                  </td>

                  <td>
                    <%= link_to "Review",
                        admin_seller_application_path(application),
                        class: "action-link" %>
                  </td>
                </tr>
              <% end %>

            <% else %>

              <tr>
                <td colspan="6">
                  <div class="empty-state">
                    No seller applications have been submitted yet.
                  </div>
                </td>
              </tr>

            <% end %>
          </tbody>
        </table>
      </div>

    </section>

    <!-- QUICK ACTIONS -->
    <section class="panel">

      <div class="panel-header">
        <h2>Quick Actions</h2>
      </div>

      <div class="quick-actions">

        <%= link_to admin_seller_applications_path,
            class: "quick-action" do %>
          <div class="quick-action-icon">♙</div>
          <div>
            <strong>Manage Seller Applications</strong>
            <span>Review and make seller approval decisions</span>
          </div>
        <% end %>

        <%= link_to listings_path, class: "quick-action" do %>
          <div class="quick-action-icon">⌂</div>
          <div>
            <strong>Visit Marketplace</strong>
            <span>See what buyers and sellers see</span>
          </div>
        <% end %>

      </div>

    </section>

  </main>

</div>

</body>
</html>
