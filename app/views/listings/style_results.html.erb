
<!DOCTYPE html>
<html>
<head>
  <title>Your Style | Loopedt</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <style>
    :root {
      --green: #244e3b;
      --dark: #193a2b;
      --lime: #d9f36a;
      --yellow: #ffe58a;
      --orange: #ff9866;
      --pink: #ffb9c9;
      --cream: #fffdf5;
      --ink: #25372c;
      --muted: #778277;
      --line: #e8ecdf;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--cream);
      color: var(--ink);
      font-family: Arial, sans-serif;
    }

    header {
      background: var(--dark);
      padding: 20px 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      color: var(--lime);
      font-size: 28px;
      font-weight: 900;
      text-decoration: none;
      letter-spacing: -1.5px;
    }

    nav {
      display: flex;
      gap: 25px;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-size: 14px;
    }

    .hero {
      background: var(--dark);
      color: white;
      padding: 65px 7% 85px;
      position: relative;
      overflow: hidden;
    }

    .hero::after {
      content: "✳";
      position: absolute;
      right: 8%;
      top: -55px;
      font-size: 300px;
      color: var(--lime);
      opacity: .12;
      transform: rotate(-15deg);
    }

    .hero-content {
      max-width: 850px;
      position: relative;
      z-index: 1;
    }

    .eyebrow {
      color: var(--lime);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    h1 {
      font-size: clamp(42px, 7vw, 76px);
      letter-spacing: -4px;
      line-height: 1;
      margin: 18px 0;
    }

    .hero-description {
      max-width: 600px;
      color: #dce6db;
      font-size: 16px;
      line-height: 1.7;
    }

    .style-pill {
      display: inline-block;
      margin-top: 20px;
      padding: 11px 17px;
      background: var(--lime);
      color: var(--dark);
      border-radius: 30px;
      font-weight: 800;
      font-size: 12px;
    }

    main {
      max-width: 1250px;
      margin: 0 auto;
      padding: 45px 25px 80px;
    }

    .results-heading {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 20px;
      margin-bottom: 25px;
    }

    .results-heading h2 {
      font-size: 30px;
      letter-spacing: -1.5px;
      color: var(--dark);
      margin: 7px 0;
    }

    .results-heading p {
      font-size: 14px;
      color: var(--muted);
      margin: 0;
    }

    .eyebrow-green {
      color: var(--green);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .refine-panel {
      background: white;
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 22px;
      margin-bottom: 35px;
    }

    .refine-form {
      display: grid;
      grid-template-columns: 1.2fr 1fr 1fr auto;
      align-items: end;
      gap: 15px;
    }

    .field label {
      display: block;
      font-size: 11px;
      font-weight: 800;
      margin-bottom: 8px;
      color: var(--dark);
    }

    .field select {
      width: 100%;
      padding: 13px;
      background: var(--cream);
      border: 1px solid var(--line);
      border-radius: 10px;
      color: var(--ink);
      font-size: 13px;
    }

    .refine-button {
      border: 0;
      background: var(--green);
      color: white;
      border-radius: 30px;
      padding: 14px 20px;
      font-weight: 800;
      cursor: pointer;
    }

    .refine-button:hover {
      background: var(--dark);
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
    }

    .product-card {
      background: white;
      border: 1px solid var(--line);
      border-radius: 18px;
      overflow: hidden;
      text-decoration: none;
      color: var(--ink);
      transition: .2s ease;
    }

    .product-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(25, 58, 43, .1);
    }

    .product-image-wrap {
      height: 245px;
      background: #edf0e7;
      position: relative;
      overflow: hidden;
    }

    .product-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .image-placeholder {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      color: var(--green);
      font-size: 35px;
    }

    .condition-tag {
      position: absolute;
      left: 12px;
      top: 12px;
      background: var(--lime);
      color: var(--dark);
      padding: 7px 10px;
      border-radius: 30px;
      font-size: 10px;
      font-weight: 800;
      text-transform: capitalize;
    }

    .product-info {
      padding: 16px;
    }

    .product-category {
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .product-title {
      font-size: 16px;
      font-weight: 800;
      margin: 9px 0;
      color: var(--dark);
    }

    .product-seller {
      font-size: 12px;
      color: var(--muted);
    }

    .product-price {
      font-size: 18px;
      font-weight: 900;
      color: var(--green);
      margin-top: 15px;
    }

    .empty-state {
      background: white;
      border: 1px dashed #cbd5c8;
      border-radius: 22px;
      padding: 65px 25px;
      text-align: center;
    }

    .empty-icon {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .empty-state h3 {
      color: var(--dark);
      font-size: 25px;
      margin: 0 0 10px;
    }

    .empty-state p {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.6;
    }

    .empty-state a,
    .new-search {
      display: inline-block;
      background: var(--green);
      color: white;
      padding: 13px 21px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: 800;
      font-size: 13px;
      margin-top: 15px;
    }

    .bottom-banner {
      margin-top: 55px;
      padding: 30px;
      border-radius: 20px;
      background: var(--yellow);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .bottom-banner h3 {
      margin: 0 0 7px;
      color: var(--dark);
      font-size: 22px;
    }

    .bottom-banner p {
      color: #62694f;
      font-size: 13px;
      margin: 0;
    }

    .bottom-banner a {
      background: var(--dark);
      color: white;
      text-decoration: none;
      padding: 13px 20px;
      border-radius: 30px;
      white-space: nowrap;
      font-size: 13px;
      font-weight: 800;
    }

    @media (max-width: 950px) {
      .product-grid { grid-template-columns: repeat(3, 1fr); }
      .refine-form { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 650px) {
      header { padding: 17px 20px; }
      nav { gap: 13px; }
      nav a { font-size: 12px; }
      .hero { padding: 55px 25px 70px; }
      h1 { letter-spacing: -2px; }
      .product-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
      .product-image-wrap { height: 190px; }
      .product-info { padding: 12px; }
      .product-title { font-size: 14px; }
      .product-price { font-size: 16px; }
      .results-heading { display: block; }
      .refine-form { grid-template-columns: 1fr; }
      .refine-button { width: 100%; }
      .bottom-banner { display: block; }
      .bottom-banner a { display: inline-block; margin-top: 18px; }
    }
  </style>
</head>

<body>
  <header>
    <%= link_to "loopedt.", listings_path, class: "logo" %>

    <nav>
      <%= link_to "Discover", listings_path %>
      <%= link_to "Style Finder", categories_path %>
    </nav>
  </header>

  <section class="hero">
    <div class="hero-content">
      <div class="eyebrow">Your Loopedt style profile</div>

      <h1><%= @style[:name] %>.</h1>

      <p class="hero-description">
        <%= @style[:description] %>
        We've gathered some finds that might be right up your street.
      </p>

      <div class="style-pill">✳ YOUR STYLE, YOUR FINDS</div>
    </div>
  </section>

  <main>
    <div class="results-heading">
      <div>
        <div class="eyebrow-green">The collection</div>
        <h2>Picked with your vibe in mind.</h2>
        <p>
          <%= pluralize(@listings.size, "find") %> in your collection.
          Explore, discover and find something you love.
        </p>
      </div>

      <%= link_to "← Change my style", categories_path, class: "new-search" %>
    </div>

    <div class="refine-panel">
      <div class="eyebrow-green" style="margin-bottom: 17px;">
        Make it more you
      </div>

      <%= form_with url: style_results_path, method: :get, local: true, class: "refine-form" do %>
        <%= hidden_field_tag :style, @style_key %>

        <div class="field">
          <label for="category_id">CATEGORY</label>
          <%= select_tag :category_id,
              options_from_collection_for_select(
                @categories, :id, :name, params[:category_id]
              ),
              include_blank: "All categories" %>
        </div>

        <div class="field">
          <label for="colour">COLOUR</label>
          <%= select_tag :colour,
              options_for_select(
                ["Black", "White", "Brown", "Beige", "Green",
                 "Blue", "Pink", "Red", "Multicolour"],
                params[:colour]
              ),
              include_blank: "Any colour" %>
        </div>

        <div class="field">
          <label for="max_price">MAXIMUM BUDGET</label>
          <%= select_tag :max_price,
              options_for_select(
                [
                  ["Under ₦5,000", 5000],
                  ["Under ₦10,000", 10000],
                  ["Under ₦20,000", 20000],
                  ["Under ₦50,000", 50000],
                  ["Under ₦100,000", 100000]
                ],
                params[:max_price]
              ),
              include_blank: "Any budget" %>
        </div>

        <button type="submit" class="refine-button">
          Update finds →
        </button>
      <% end %>
    </div>

    <% if @listings.any? %>
      <div class="product-grid">
        <% @listings.each do |listing| %>
          <%= link_to listing_path(listing), class: "product-card" do %>
            <div class="product-image-wrap">
              <% if listing.images.attached? %>
                <%= image_tag listing.images.first,
                    class: "product-image",
                    alt: listing.title %>
              <% else %>
                <div class="image-placeholder">✳</div>
              <% end %>

              <% if listing.condition.present? %>
                <span class="condition-tag">
                  <%= listing.condition %>
                </span>
              <% end %>
            </div>

            <div class="product-info">
              <div class="product-category">
                <%= listing.category&.name || "Pre-loved find" %>
              </div>

              <div class="product-title">
                <%= listing.title %>
              </div>

              <div class="product-seller">
                Listed by @<%= listing.user.username %>
              </div>

              <div class="product-price">
                <%= number_to_currency(listing.price, unit: "₦", precision: 0) %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-icon">✳</div>
        <h3>Your next find is still out there.</h3>
        <p>
          We couldn't find listings matching all those preferences just yet.
          Try another colour, category or budget.
        </p>
        <%= link_to "Explore all listings", listings_path %>
      </div>
    <% end %>

    <div class="bottom-banner">
      <div>
        <h3>Still exploring your style?</h3>
        <p>There are more pre-loved finds waiting to be discovered.</p>
      </div>

      <%= link_to "Start a new style search", categories_path %>
    </div>
  </main>
</body>
</html>
