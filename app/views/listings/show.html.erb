
<style>
  .listing-page {
    max-width: 1100px;
    margin: 45px auto;
    padding: 25px;
    color: #24372a;
    font-family: Arial, sans-serif;
  }

  .listing-back {
    display: inline-block;
    margin-bottom: 25px;
    color: #42684e;
    text-decoration: none;
    font-size: 14px;
  }

  .listing-success {
    padding: 15px 18px;
    margin-bottom: 25px;
    border-radius: 9px;
    background: #eaf5ed;
    color: #245b38;
    font-size: 14px;
  }

  .listing-layout {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 45px;
    align-items: start;
  }

  .listing-gallery {
    background: #f5f7f4;
    border-radius: 16px;
    overflow: hidden;
    min-height: 420px;
  }

  .listing-main-image {
    width: 100%;
    height: 520px;
    object-fit: cover;
    display: block;
  }

  .listing-placeholder {
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #879187;
    font-size: 15px;
  }

  .listing-details {
    padding: 10px 0;
  }

  .listing-category {
    color: #718075;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 14px;
  }

  .listing-details h1 {
    font-size: 34px;
    line-height: 1.2;
    margin: 0 0 15px;
  }

  .listing-price {
    font-size: 27px;
    font-weight: 700;
    color: #244e3b;
    margin: 0 0 25px;
  }

  .listing-divider {
    border: 0;
    border-top: 1px solid #e5e9e3;
    margin: 25px 0;
  }

  .listing-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .listing-info div {
    padding: 13px;
    background: #f7f9f6;
    border-radius: 9px;
  }

  .listing-info span {
    display: block;
    color: #788278;
    font-size: 12px;
    margin-bottom: 6px;
  }

  .listing-info strong {
    font-size: 14px;
  }

  .listing-description h3 {
    font-size: 17px;
    margin-bottom: 10px;
  }

  .listing-description p {
    color: #667168;
    line-height: 1.7;
    white-space: pre-line;
  }

  .listing-seller {
    color: #667168;
    font-size: 14px;
  }

  .seller-profile-link {
    color: #244e3b;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .listing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .listing-button {
    display: inline-block;
    padding: 14px 20px;
    border-radius: 8px;
    background: #244e3b;
    color: white;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
  }

  .listing-button.secondary {
    background: #edf2ed;
    color: #244e3b;
  }

  @media (max-width: 750px) {
    .listing-page {
      margin: 20px auto;
      padding: 15px;
    }

    .listing-layout {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .listing-main-image {
      height: 350px;
    }

    .listing-details h1 {
      font-size: 28px;
    }
  }
</style>

<div class="listing-page">
  <%= link_to "← Back to marketplace", listings_path, class: "listing-back" %>

  <% if notice.present? %>
    <div class="listing-success">
      <%= notice %>
    </div>
  <% end %>

  <div class="listing-layout">
    <div class="listing-gallery">
      <% if @listing.images.attached? %>
        <%= image_tag @listing.images.first,
            class: "listing-main-image",
            alt: @listing.title %>
      <% else %>
        <div class="listing-placeholder">
          No product photo available
        </div>
      <% end %>
    </div>

    <div class="listing-details">
      <p class="listing-category">
        <%= @listing.category&.name || "Pre-loved item" %>
      </p>

      <h1><%= @listing.title %></h1>

      <p class="listing-price">
        <%= number_to_currency(@listing.price, unit: "₦", precision: 0) %>
      </p>

      <div class="listing-info">
        <div>
          <span>Condition</span>
          <strong><%= @listing.condition.presence || "Not specified" %></strong>
        </div>

        <div>
          <span>Brand</span>
          <strong><%= @listing.brand.presence || "Not specified" %></strong>
        </div>

        <div>
          <span>Size</span>
          <strong><%= @listing.size.presence || "Not specified" %></strong>
        </div>

        <div>
          <span>Colour</span>
          <strong><%= @listing.colour.presence || "Not specified" %></strong>
        </div>
      </div>

      <hr class="listing-divider">

      <div class="listing-description">
        <h3>About this item</h3>
        <p><%= @listing.description %></p>
      </div>

      <hr class="listing-divider">

      <p class="listing-seller">
        Listed by

        <%= link_to @listing.user.username,
            seller_profile_path(@listing.user),
            class: "seller-profile-link" %>
      </p>

      <div class="listing-actions">
        <%= link_to "Back to marketplace", listings_path,
            class: "listing-button" %>

        <% if session[:user_id].present? && @listing.user_id == session[:user_id] %>
          <%= link_to "Seller dashboard", seller_dashboard_path,
              class: "listing-button secondary" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
