<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Become a Seller | Loopedt</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --green: #244e3b;
      --dark: #193a2b;
      --lime: #d9f36a;
      --yellow: #ffe58a;
      --orange: #ff9866;
      --pink: #ffb9c9;
      --cream: #fffdf5;
      --ink: #25372c;
      --muted: #78847a;
      --line: #e9e9df;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--cream);
      color: var(--ink);
      font-family: "DM Sans", sans-serif;
    }

    a {
      text-decoration: none;
    }

    .topbar {
      height: 78px;
      padding: 0 7%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--green);
      position: relative;
      z-index: 5;
    }

    .brand {
      color: white;
      font-family: "Space Grotesk", sans-serif;
      font-size: 29px;
      font-weight: 700;
      letter-spacing: -1.8px;
    }

    .brand span {
      color: var(--lime);
    }

    .topbar-note {
      color: rgba(255,255,255,.75);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .page {
      width: min(1180px, 90%);
      margin: 58px auto 75px;
    }

    .breadcrumb {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 28px;
    }

    .breadcrumb a {
      color: var(--green);
      font-weight: 700;
    }

    .application-layout {
      display: grid;
      grid-template-columns: .92fr 1.08fr;
      gap: 22px;
      align-items: stretch;
    }

    /* LEFT INTRO PANEL */

    .intro-panel {
      position: relative;
      overflow: hidden;
      min-height: 650px;
      padding: 48px 42px;
      border-radius: 28px;
      background: var(--green);
      color: white;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .intro-panel::before {
      content: "";
      position: absolute;
      width: 360px;
      height: 360px;
      border: 1px solid rgba(217,243,106,.2);
      border-radius: 50%;
      right: -150px;
      top: 150px;
    }

    .intro-panel::after {
      content: "";
      position: absolute;
      width: 250px;
      height: 250px;
      border: 1px solid rgba(217,243,106,.16);
      border-radius: 50%;
      right: -95px;
      top: 205px;
    }

    .intro-content,
    .intro-bottom {
      position: relative;
      z-index: 2;
    }

    .community-tag {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 9px 13px;
      border-radius: 30px;
      background: rgba(217,243,106,.12);
      color: var(--lime);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .community-tag span {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--lime);
    }

    .intro-panel h1 {
      max-width: 440px;
      margin: 35px 0 20px;
      font-family: "Space Grotesk", sans-serif;
      font-size: clamp(42px, 5vw, 61px);
      line-height: .99;
      letter-spacing: -3.5px;
    }

    .intro-panel h1 em {
      color: var(--lime);
      font-style: normal;
    }

    .intro-description {
      max-width: 370px;
      color: rgba(255,255,255,.72);
      font-size: 15px;
      line-height: 1.8;
    }

    .creative-stamp {
      width: 145px;
      height: 145px;
      margin: 42px 0 20px;
      border-radius: 50%;
      background: var(--lime);
      color: var(--green);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      transform: rotate(-10deg);
      box-shadow: 0 12px 35px rgba(0,0,0,.12);
    }

    .creative-stamp strong {
      font-family: "Space Grotesk", sans-serif;
      font-size: 38px;
      line-height: 1;
    }

    .creative-stamp span {
      margin-top: 7px;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .intro-bottom {
      padding-top: 25px;
      border-top: 1px solid rgba(255,255,255,.18);
      color: rgba(255,255,255,.7);
      font-size: 12px;
      line-height: 1.7;
    }

    .intro-bottom strong {
      color: white;
    }

    /* RIGHT FORM PANEL */

    .form-panel {
      padding: 43px;
      border: 1px solid var(--line);
      border-radius: 28px;
      background: white;
      box-shadow: 0 18px 55px rgba(36,78,59,.055);
    }

    .form-heading {
      margin-bottom: 34px;
    }

    .step-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--green);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .step-number {
      width: 25px;
      height: 25px;
      border-radius: 50%;
      background: var(--lime);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      letter-spacing: 0;
    }

    .form-heading h2 {
      margin: 18px 0 10px;
      color: var(--green);
      font-family: "Space Grotesk", sans-serif;
      font-size: 34px;
      letter-spacing: -1.5px;
      line-height: 1.1;
    }

    .form-heading p {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.7;
    }

    .form-divider {
      height: 1px;
      margin-bottom: 27px;
      background: var(--line);
    }

    .field-group {
      margin-bottom: 23px;
    }

    .field-group label {
      display: block;
      margin-bottom: 9px;
      color: var(--ink);
      font-size: 13px;
      font-weight: 800;
    }

    .field-hint {
      margin: -3px 0 10px;
      color: #929b91;
      font-size: 12px;
    }

    .field-group input,
    .field-group textarea {
      display: block;
      width: 100%;
      padding: 15px 16px;
      border: 1px solid #e4e8df;
      border-radius: 12px;
      outline: none;
      background: #fbfcf8;
      color: var(--ink);
      font-family: "DM Sans", sans-serif;
      font-size: 14px;
      transition: border-color .2s, box-shadow .2s, background .2s;
    }

    .field-group input {
      height: 53px;
    }

    .field-group textarea {
      min-height: 135px;
      resize: vertical;
      line-height: 1.7;
    }

    .field-group input:focus,
    .field-group textarea:focus {
      border-color: var(--green);
      background: white;
      box-shadow: 0 0 0 4px rgba(36,78,59,.08);
    }

    .field-group input::placeholder,
    .field-group textarea::placeholder {
      color: #aab2a8;
    }

    .submit-button {
      width: 100%;
      min-height: 57px;
      margin-top: 7px;
      padding: 16px 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      border: none;
      border-radius: 12px;
      background: var(--green);
      color: white;
      font-family: "DM Sans", sans-serif;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
      transition: background .2s, transform .2s, box-shadow .2s;
    }

    .submit-button:hover {
      background: var(--dark);
      transform: translateY(-2px);
      box-shadow: 0 9px 22px rgba(25,58,43,.18);
    }

    .submit-button span {
      color: var(--lime);
      font-size: 19px;
    }

    .privacy-note {
      margin: 18px 0 0;
      color: #929b91;
      font-size: 11px;
      line-height: 1.7;
      text-align: center;
    }

    .errors {
      margin-bottom: 25px;
      padding: 17px 19px;
      border: 1px solid #ffd8d1;
      border-radius: 13px;
      background: #fff4f1;
      color: #a72c20;
      font-size: 13px;
      line-height: 1.7;
    }

    .errors strong {
      display: block;
      margin-bottom: 6px;
    }

    .errors ul {
      margin: 0;
      padding-left: 19px;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 27px;
      color: var(--green);
      font-size: 13px;
      font-weight: 800;
      transition: gap .2s;
    }

    .back-link:hover {
      gap: 13px;
    }

    /* APPLICATION RECEIVED */

    .success-panel {
      min-height: 490px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .success-icon {
      width: 68px;
      height: 68px;
      margin-bottom: 27px;
      border-radius: 22px;
      background: var(--lime);
      color: var(--green);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 33px;
      font-weight: 800;
      transform: rotate(-5deg);
    }

    .success-panel h2 {
      margin: 0 0 12px;
      color: var(--green);
      font-family: "Space Grotesk", sans-serif;
      font-size: 36px;
      letter-spacing: -1.5px;
    }

    .success-description {
      margin: 0 0 28px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.8;
    }

    .application-details {
      padding: 22px;
      border: 1px solid #e6eddb;
      border-radius: 15px;
      background: #f8faef;
    }

    .detail-row {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      padding: 11px 0;
      border-bottom: 1px solid #e6eddb;
      font-size: 13px;
    }

    .detail-row:last-child {
      border-bottom: none;
    }

    .detail-row span:first-child {
      color: var(--muted);
    }

    .detail-row strong {
      color: var(--green);
      text-align: right;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 10px;
      border-radius: 30px;
      background: var(--yellow);
      color: #67521c;
      font-size: 11px;
      font-weight: 800;
    }

    .status-pill::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #b68b21;
    }

    .footer {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      margin-top: 30px;
      padding-top: 22px;
      border-top: 1px solid var(--line);
      color: #929b91;
      font-size: 11px;
    }

    .footer strong {
      color: var(--green);
    }

    @media (max-width: 850px) {
      .application-layout {
        grid-template-columns: 1fr;
      }

      .intro-panel {
        min-height: 440px;
        padding: 38px;
      }

      .intro-panel h1 {
        max-width: 500px;
        font-size: 53px;
      }

      .creative-stamp {
        position: absolute;
        right: 35px;
        bottom: 65px;
        width: 110px;
        height: 110px;
      }

      .creative-stamp strong {
        font-size: 30px;
      }

      .intro-bottom {
        max-width: 65%;
      }
    }

    @media (max-width: 560px) {
      .topbar {
        height: 68px;
        padding: 0 6%;
      }

      .brand {
        font-size: 25px;
      }

      .topbar-note {
        font-size: 9px;
        letter-spacing: 1px;
      }

      .page {
        width: 92%;
        margin: 28px auto 45px;
      }

      .breadcrumb {
        margin-bottom: 18px;
      }

      .intro-panel {
        min-height: 420px;
        padding: 30px 25px;
        border-radius: 21px;
      }

      .intro-panel h1 {
        margin-top: 28px;
        font-size: 45px;
        letter-spacing: -2.5px;
      }

      .intro-description {
        max-width: 290px;
        font-size: 13px;
      }

      .creative-stamp {
        right: 20px;
        bottom: 65px;
        width: 85px;
        height: 85px;
      }

      .creative-stamp strong {
        font-size: 24px;
      }

      .creative-stamp span {
        font-size: 7px;
      }

      .intro-bottom {
        max-width: 100%;
        font-size: 10px;
      }

      .form-panel {
        padding: 29px 23px;
        border-radius: 21px;
      }

      .form-heading h2 {
        font-size: 29px;
      }

      .footer {
        flex-direction: column;
        gap: 8px;
      }
    }
  </style>
</head>

<body>

  <header class="topbar">
    <a href="/" class="brand">loopedt<span>.</span></a>
    <div class="topbar-note">A marketplace with a story</div>
  </header>

  <main class="page">

    <div class="breadcrumb">
      <a href="<%= listings_path %>">Discover</a>
      <span>/</span>
      <span>Seller community</span>
    </div>

    <div class="application-layout">

      <section class="intro-panel">
        <div class="intro-content">
          <div class="community-tag">
            <span></span>
            The Loopedt Seller Community
          </div>

          <h1>
            Your next
            <em>chapter</em>
            starts here.
          </h1>

          <p class="intro-description">
            Got pieces worth passing on? A collection worth discovering?
            Bring your shop to Loopedt and give great finds a new home.
          </p>

          <div class="creative-stamp">
            <strong>LOOP</strong>
            <span>Good finds live on</span>
          </div>
        </div>

        <div class="intro-bottom">
          <strong>Good things deserve another story.</strong><br>
          Join a community that makes pre-loved fashion worth discovering.
        </div>
      </section>

      <section class="form-panel">

        <% if @seller_application.persisted? %>

          <div class="success-panel">

            <div class="success-icon">✓</div>

            <div class="step-label">
              <span class="step-number">✓</span>
              Application submitted
            </div>

            <h2>You're on your way!</h2>

            <p class="success-description">
              Thanks for choosing Loopedt. Your shop application has been received.
              Our team will review your details, and your seller journey can begin
              once your application is approved.
            </p>

            <div class="application-details">

              <div class="detail-row">
                <span>Shop name</span>
                <strong><%= @seller_application.shop_name %></strong>
              </div>

              <div class="detail-row">
                <span>Application status</span>
                <strong>
                  <span class="status-pill">
                    <%= @seller_application.status.capitalize %>
                  </span>
                </strong>
              </div>

            </div>

          </div>

        <% else %>

          <div class="form-heading">

            <div class="step-label">
              <span class="step-number">01</span>
              Let's get to know your shop
            </div>

            <h2>Let's make it official.</h2>

            <p>
              Tell us a little about your business. We'll use these details
              to review your seller application.
            </p>

          </div>

          <div class="form-divider"></div>

          <% if @seller_application.errors.any? %>
            <div class="errors">
              <strong>Please check the following details:</strong>
              <ul>
                <% @seller_application.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= form_with model: @seller_application,
                        url: seller_onboarding_path,
                        method: :post do |form| %>

            <div class="field-group">
              <%= form.label :shop_name, "What's your shop called?" %>
              <p class="field-hint">Choose a name buyers will remember.</p>

              <%= form.text_field :shop_name,
                  placeholder: "e.g. The Vintage Closet",
                  required: true %>
            </div>

            <div class="field-group">
              <%= form.label :description, "Tell us about your shop" %>
              <p class="field-hint">What do you sell, and what makes your shop special?</p>

              <%= form.text_area :description,
                  placeholder: "Tell us about your collection, your style and the pieces buyers can expect to find...",
                  required: true %>
            </div>

            <div class="field-group">
              <%= form.label :location, "Where is your shop based?" %>
              <p class="field-hint">Let buyers know where your shop is located.</p>

              <%= form.text_field :location,
                  placeholder: "e.g. Lekki, Lagos",
                  required: true %>
            </div>

            <%= form.submit "Submit seller application",
                class: "submit-button" %>

            <p class="privacy-note">
              By submitting, you're asking to join the Loopedt seller community.
              Your application will be reviewed before your shop is approved.
            </p>

          <% end %>

        <% end %>

        <%= link_to "← Back to Discover", listings_path, class: "back-link" %>

      </section>

    </div>

    <footer class="footer">
      <span>© <%= Date.current.year %> <strong>Loopedt.</strong> Good finds live on.</span>
      <span>Made for things worth discovering.</span>
    </footer>

  </main>

</body>
</html>
