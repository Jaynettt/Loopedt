
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Become a Seller | Loopedt</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f8f8f6;
      color: #244e3b;
      font-family: Arial, sans-serif;
    }

    header {
      background: #244e3b;
      padding: 22px 8%;
    }

    header a {
      color: white;
      text-decoration: none;
      font-size: 25px;
      font-weight: bold;
    }

    .container {
      max-width: 720px;
      margin: 55px auto;
      padding: 0 20px;
    }

    .form-card {
      background: white;
      padding: 40px;
      border-radius: 16px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.05);
    }

    .eyebrow {
      color: #78947f;
      font-size: 12px;
      font-weight: bold;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    h1 {
      font-size: 32px;
      margin-bottom: 12px;
    }

    .intro {
      color: #777;
      line-height: 1.6;
      margin-bottom: 30px;
    }

    label {
      display: block;
      font-weight: bold;
      margin: 20px 0 8px;
    }

    input, textarea {
      width: 100%;
      padding: 14px;
      border: 1px solid #ddd;
      border-radius: 8px;
      font-size: 15px;
      font-family: inherit;
    }

    textarea {
      min-height: 120px;
      resize: vertical;
    }

    .submit-button {
      width: 100%;
      margin-top: 25px;
      padding: 16px;
      background: #244e3b;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    .submit-button:hover {
      background: #183a2b;
    }

    .notice {
      background: #edf5ee;
      padding: 25px;
      border-radius: 12px;
      line-height: 1.7;
    }

    .errors {
      color: #b42318;
      background: #fff0ee;
      padding: 15px 25px;
      border-radius: 8px;
    }

    .back-link {
      display: inline-block;
      margin-top: 25px;
      color: #244e3b;
      text-decoration: none;
    }

    @media (max-width: 600px) {
      .form-card {
        padding: 25px 20px;
      }

      h1 {
        font-size: 26px;
      }
    }
  </style>
</head>

<body>

<header>
  <a href="/">loopedt.</a>
</header>

<div class="container">
  <div class="form-card">

    <p class="eyebrow">The Loopedt Seller Community</p>

    <% if @seller_application.persisted? %>

      <h1>Application received!</h1>

      <div class="notice">
        <h3>Your shop is awaiting approval.</h3>
        <p>
          Thank you for applying to become a Loopedt seller.
          Our team will review your shop details.
        </p>
        <p>
          <strong>Shop:</strong>
          <%= @seller_application.shop_name %>
        </p>
        <p>
          <strong>Status:</strong>
          <%= @seller_application.status.capitalize %>
        </p>
      </div>

    <% else %>

      <h1>Open your shop on Loopedt.</h1>

      <p class="intro">
        Turn the items you love into a business.
        Set up your seller profile and start your journey
        with the Loopedt community.
      </p>

      <% if @seller_application.errors.any? %>
        <div class="errors">
          <strong>Please correct the following:</strong>
          <ul>
            <% @seller_application.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @seller_application,
                    url: seller_onboarding_path,
                    method: :post do |form| %>

        <label>Shop name</label>
        <%= form.text_field :shop_name,
            placeholder: "e.g. The Vintage Closet",
            required: true %>

        <label>Tell us about your shop</label>
        <%= form.text_area :description,
            placeholder: "What do you sell? Tell buyers about your shop...",
            required: true %>

        <label>Shop location</label>
        <%= form.text_field :location,
            placeholder: "e.g. Lekki, Lagos",
            required: true %>

        <%= form.submit "Submit Seller Application",
            class: "submit-button" %>

      <% end %>

    <% end %>

    <%= link_to "← Back to Discover", listings_path, class: "back-link" %>

  </div>
</div>

</body>
</html>
