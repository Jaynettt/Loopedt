
<% content_for :title, "Seller Dashboard | Loopedt" %>

<style>
  * {
    box-sizing: border-box;
  }

  :root {
    --loop-green: #244e3b;
    --loop-dark: #193a2b;
    --loop-lime: #d9f36a;
    --loop-cream: #fffdf5;
    --loop-ink: #25372c;
    --loop-muted: #7b877d;
    --loop-border: #e8ebdf;
  }

  body {
    background: var(--loop-cream);
  }

  .dashboard {
    max-width: 1320px;
    margin: 0 auto;
    padding: 42px 34px 60px;
    font-family: Arial, sans-serif;
    color: var(--loop-ink);
  }

  /* Welcome panel */

  .welcome-panel {
    position: relative;
    overflow: hidden;
    min-height: 265px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 42px 48px;
    margin-bottom: 30px;
    border-radius: 25px;
    background: var(--loop-green);
    color: white;
  }

  .welcome-copy {
    position: relative;
    z-index: 2;
    max-width: 620px;
  }

  .welcome-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 20px;
    color: var(--loop-lime);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .welcome-eyebrow::before {
    content: "";
    width: 24px;
    height: 2px;
    background: var(--loop-lime);
  }

  .welcome-panel h1 {
    margin: 0 0 13px;
    font-size: clamp(32px, 4vw, 49px);
    line-height: 1.05;
    letter-spacing: -1.8px;
  }

  .welcome-panel h1 span {
    color: var(--loop-lime);
  }

  .welcome-panel p {
    margin: 0;
    color: rgba(255,255,255,.76);
    font-size: 15px;
    line-height: 1.7;
  }

  .welcome-decoration {
    position: absolute;
    width: 330px;
    height: 330px;
    right: 80px;
    top: -125px;
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 50%;
  }

  .welcome-decoration::before,
  .welcome-decoration::after {
    content: "";
    position: absolute;
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 50%;
  }

  .welcome-decoration::before {
    inset: 35px;
  }

  .welcome-decoration::after {
    inset: 75px;
  }

  .welcome-sticker {
    position: absolute;
    right: 90px;
    bottom: 35px;
    z-index: 1;
    width: 105px;
    height: 105px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--loop-lime);
    color: var(--loop-dark);
    font-size: 38px;
    transform: rotate(-12deg);
  }

  .header-actions {
    position: relative;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .dashboard-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 17px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: transform .2s ease, background .2s ease;
  }

  .dashboard-btn:hover {
    transform: translateY(-2px);
  }

  .primary-btn {
    background: var(--loop-lime);
    color: var(--loop-dark);
  }

  .primary-btn:hover {
    background: #e6ff83;
  }

  .secondary-btn {
    border: 1px solid rgba(255,255,255,.35);
    color: white;
    background: rgba(255,255,255,.08);
  }

  .secondary-btn:hover {
    background: rgba(255,255,255,.16);
  }

  .messages-nav-link {
    position: relative;
  }

  .messages-nav-badge {
    position: absolute;
    top: -8px;
    right: -7px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--loop-green);
    border-radius: 50px;
    background: #ff9866;
    color: var(--loop-dark);
    font-size: 10px;
    font-weight: 800;
  }

  /* Statistics */

  .stats-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin: 35px 0 17px;
  }

  .stats-heading h2,
  .section-heading h2 {
    margin: 0;
    font-size: 21px;
    letter-spacing: -.5px;
  }

  .stats-heading span {
    color: var(--loop-muted);
    font-size: 12px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 17px;
    margin-bottom: 45px;
  }

  .stat-card {
    position: relative;
    overflow: hidden;
    min-height: 155px;
    padding: 23px 25px;
    border: 1px solid var(--loop-border);
    border-radius: 18px;
    background: white;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  .stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(36,78,59,.07);
  }

  .stat-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 19px;
  }

  .stat-label {
    color: var(--loop-muted);
    font-size: 13px;
    font-weight: 600;
  }

  .stat-icon {
    width: 37px;
    height: 37px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: #edf4e8;
    color: var(--loop-green);
    font-size: 17px;
  }

  .stat-card:nth-child(2) .stat-icon {
    background: #f1f5d9;
  }

  .stat-card:nth-child(3) .stat-icon {
    background: #fff0e8;
  }

  .stat-card h2 {
    margin: 0;
    color: var(--loop-dark);
    font-size: 36px;
    letter-spacing: -1.5px;
  }

  .stat-card::after {
    content: "";
    position: absolute;
    right: -22px;
    bottom: -42px;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: rgba(217,243,106,.13);
  }

  /* Sections */

  .section {
    margin-bottom: 42px;
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 18px;
  }

  .section-heading p {
    margin: 6px 0 0;
    color: var(--loop-muted);
    font-size: 13px;
  }

  .section-count {
    padding: 7px 12px;
    border-radius: 30px;
    background: #edf4e8;
    color: var(--loop-green);
    font-size: 12px;
    font-weight: 800;
  }

  .view-all-orders-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    border-radius: 9px;
    background: var(--loop-green);
    color: white;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background .2s ease;
  }

  .view-all-orders-button:hover {
    background: var(--loop-dark);
  }

  /* Listings */

  .listings-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
  }

  .listing-card {
    display: flex;
    align-items: center;
    gap: 17px;
    min-width: 0;
    padding: 15px;
    border: 1px solid var(--loop-border);
    border-radius: 17px;
    background: white;
    transition: border-color .2s ease, transform .2s ease;
  }

  .listing-card:hover {
    transform: translateY(-3px);
    border-color: #cbd8c9;
  }

  .listing-image {
    flex: 0 0 100px;
    width: 100px;
    height: 112px;
    overflow: hidden;
    border-radius: 12px;
    background: #f1f3eb;
  }

  .listing-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .listing-image-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: #9aa695;
    font-size: 27px;
  }

  .listing-info {
    flex: 1;
    min-width: 0;
  }

  .listing-info h3 {
    overflow: hidden;
    margin: 0 0 7px;
    color: var(--loop-dark);
    font-size: 15px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .listing-info p {
    margin: 5px 0;
    color: var(--loop-muted);
    font-size: 12px;
  }

  .listing-price {
    margin-top: 10px;
    color: var(--loop-green);
    font-size: 16px;
    font-weight: 800;
  }

  .listing-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }

  .listing-status {
    display: inline-flex;
    align-items: center;
    padding: 6px 10px;
    border-radius: 30px;
    background: #edf4e8;
    color: var(--loop-green);
    font-size: 10px;
    font-weight: 800;
    text-transform: capitalize;
  }

  .listing-status.sold {
    background: #fff0e8;
    color: #a65331;
  }

  .listing-status.pending {
    background: #fff5d9;
    color: #8b6b16;
  }

  .listing-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .listing-actions a {
    color: var(--loop-green);
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
  }

  .listing-actions a:hover {
    text-decoration: underline;
  }

  /* Orders */

  .orders-container {
    overflow: hidden;
    border: 1px solid var(--loop-border);
    border-radius: 17px;
    background: white;
  }

  .order-card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .order-card-link:hover .order-card {
    background: #f8faf5;
    cursor: pointer;
  }

  .order-card-link:focus-visible {
    outline: 2px solid #315d45;
    outline-offset: 3px;
    border-radius: 10px;
  }

  .order-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 19px 22px;
    border-bottom: 1px solid var(--loop-border);
    transition: background .2s ease;
  }

  .order-card:last-child {
    border-bottom: 0;
  }

  .order-info {
    min-width: 0;
  }

  .order-info h3 {
    overflow: hidden;
    margin: 0 0 7px;
    color: var(--loop-dark);
    font-size: 14px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .order-info p {
    margin: 4px 0;
    color: var(--loop-muted);
    font-size: 12px;
  }

  .order-right {
    flex-shrink: 0;
    text-align: right;
  }

  .order-amount {
    margin-bottom: 8px;
    color: var(--loop-green);
    font-size: 15px;
    font-weight: 800;
  }

  .order-payment-status {
    margin-bottom: 7px;
  }

  /* Empty states */

  .empty-state {
    padding: 48px 25px;
    border: 1px dashed #d6dfd2;
    border-radius: 17px;
    background: #f8f9f3;
    text-align: center;
  }

  .empty-icon {
    width: 55px;
    height: 55px;
    display: grid;
    place-items: center;
    margin: 0 auto 15px;
    border-radius: 17px;
    background: var(--loop-lime);
    color: var(--loop-dark);
    font-size: 24px;
  }

  .empty-state h3 {
    margin: 0 0 8px;
    color: var(--loop-dark);
    font-size: 17px;
  }

  .empty-state p {
    margin: 0 0 20px;
    color: var(--loop-muted);
    font-size: 13px;
  }

  .empty-state .primary-btn {
    background: var(--loop-green);
    color: white;
  }

  /* Footer */

  .dashboard-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-top: 50px;
    padding-top: 22px;
    border-top: 1px solid var(--loop-border);
  }

  .footer-brand {
    color: var(--loop-green);
    font-size: 17px;
    font-weight: 900;
    letter-spacing: -1px;
  }

  .footer-brand span {
    color: #a5c84d;
  }

  .dashboard-footer a {
    color: var(--loop-muted);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }

  .dashboard-footer a:hover {
    color: var(--loop-green);
  }

  @media (max-width: 900px) {
    .welcome-panel {
      align-items: flex-start;
      flex-direction: column;
      padding: 35px;
    }

    .header-actions {
      max-width: 100%;
    }

    .welcome-decoration {
      right: -80px;
    }

    .welcome-sticker {
      right: 35px;
      bottom: 30px;
      width: 75px;
      height: 75px;
      font-size: 29px;
    }

    .listings-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .dashboard {
      padding: 22px 15px 40px;
    }

    .welcome-panel {
      min-height: 260px;
      padding: 28px 23px;
      border-radius: 19px;
    }

    .welcome-panel h1 {
      font-size: 34px;
    }

    .welcome-panel p {
      max-width: 260px;
      font-size: 13px;
    }

    .header-actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }

    .dashboard-btn {
      padding: 0 10px;
      font-size: 11px;
    }

    .stats-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .stats-grid {
      grid-template-columns: 1fr;
      gap: 11px;
      margin-bottom: 35px;
    }

    .stat-card {
      min-height: 125px;
      padding: 19px;
    }

    .stat-top {
      margin-bottom: 12px;
    }

    .stat-card h2 {
      font-size: 31px;
    }

    .section-heading h2 {
      font-size: 19px;
    }

    .listing-card {
      align-items: flex-start;
      gap: 12px;
      padding: 12px;
    }

    .listing-image {
      flex-basis: 82px;
      width: 82px;
      height: 100px;
    }

    .listing-info h3 {
      font-size: 13px;
    }

    .listing-price {
      font-size: 14px;
    }

    .listing-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 9px;
    }

    .section-heading {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .order-card {
      align-items: flex-start;
      padding: 16px;
    }

    .order-info h3 {
      max-width: 190px;
    }

    .order-amount {
      font-size: 13px;
    }

    .dashboard-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<div class="dashboard">

  <section class="welcome-panel">
    <div class="welcome-decoration"></div>
    <div class="welcome-sticker">✳</div>

    <div class="welcome-copy">
      <div class="welcome-eyebrow">Your Loopedt studio</div>

      <h1>
        Your shop.<br>
        Your <span>moment.</span>
      </h1>

      <p>
        Welcome back,
        <strong><%= @seller.first_name.presence || @seller.username %></strong>.
        Here's what's happening with your shop.
      </p>
    </div>

    <div class="header-actions">
      <%= link_to "Discover", listings_path,
          class: "dashboard-btn secondary-btn" %>

      <%= link_to "My Profile", my_profile_path,
          class: "dashboard-btn secondary-btn" %>

      <%= link_to inbox_path,
          class: "dashboard-btn secondary-btn messages-nav-link" do %>
        Messages

        <% unread_count = unread_message_count(@seller) %>
        <% if unread_count > 0 %>
          <span class="messages-nav-badge">
            <%= unread_count > 99 ? "99+" : unread_count %>
          </span>
        <% end %>
      <% end %>

      <%= link_to "+ Add a listing", new_listing_path,
          class: "dashboard-btn primary-btn" %>
    </div>
  </section>

  <div class="stats-heading">
    <h2>Your shop at a glance</h2>
    <span>Your listing overview</span>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-top">
        <span class="stat-label">Total listings</span>
        <span class="stat-icon">▤</span>
      </div>
      <h2><%= @total_listings %></h2>
    </div>

    <div class="stat-card">
      <div class="stat-top">
        <span class="stat-label">Available listings</span>
        <span class="stat-icon">✳</span>
      </div>
      <h2><%= @active_listings %></h2>
    </div>

    <div class="stat-card">
      <div class="stat-top">
        <span class="stat-label">Sold listings</span>
        <span class="stat-icon">↗</span>
      </div>
      <h2><%= @sold_listings %></h2>
    </div>
  </div>

  <section class="section">
    <div class="section-heading">
      <div>
        <h2>Your listings</h2>
        <p>Keep your shop looking fresh.</p>
      </div>

      <span class="section-count">
        <%= @listings.size %> items
      </span>
    </div>

    <% if @listings.any? %>
      <div class="listings-grid">
        <% @listings.each do |listing| %>
          <article class="listing-card">

            <div class="listing-image">
              <% if listing.images.attached? %>
                <%= image_tag listing.images.first,
                    alt: listing.title %>
              <% else %>
                <div class="listing-image-placeholder">✳</div>
              <% end %>
            </div>

            <div class="listing-info">
              <h3><%= listing.title %></h3>

              <p>
                <%= [listing.brand, listing.condition].compact_blank.join(" · ") %>
              </p>

              <div class="listing-price">
                <%= number_to_currency(listing.price, unit: "₦") %>
              </div>

              <div class="listing-bottom">
                <% status_class = listing.status.to_s.downcase %>

                <span class="listing-status <%= status_class %>">
                  <%= listing.status %>
                </span>

                <div class="listing-actions">
                  <%= link_to "View", listing_path(listing) %>
                  <%= link_to "Edit", edit_listing_path(listing) %>
                </div>
              </div>
            </div>

          </article>
        <% end %>
      </div>

    <% else %>
      <div class="empty-state">
        <div class="empty-icon">✳</div>
        <h3>Your shop is waiting for its first find.</h3>
        <p>List your first item and give it a new home.</p>

        <%= link_to "Add your first listing",
            new_listing_path,
            class: "dashboard-btn primary-btn" %>
      </div>
    <% end %>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <h2>Recent orders</h2>
        <p>Stay up to date with activity in your shop.</p>
      </div>

      <%= link_to "View all orders",
          orders_path,
          class: "view-all-orders-button" %>
    </div>

    <% if @recent_orders.any? %>
      <div class="orders-container">
        <% @recent_orders.each do |order| %>

          <%= link_to order_path(order), class: "order-card-link" do %>
            <div class="order-card">

              <div class="order-info">
                <h3>
                  <%= order.listing&.title || "Order ##{order.id}" %>
                </h3>

                <p>
                  Order #<%= order.id %>
                </p>

                <p>
                  Buyer:
                  <%= order.buyer&.username || order.buyer&.email || "Unavailable" %>
                </p>

                <p>
                  Placed <%= order.created_at.strftime("%d %b %Y") %>
                </p>
              </div>

              <div class="order-right">
                <div class="order-amount">
                  <%= number_to_currency(order.amount, unit: "₦") %>
                </div>

                <div class="order-payment-status">
                  <span class="listing-status">
                    Payment: <%= order.status.humanize %>
                  </span>
                </div>

                <span class="listing-status pending">
                  Delivery: <%= order.delivery_status.humanize %>
                </span>
              </div>

            </div>
          <% end %>

        <% end %>
      </div>

    <% else %>
      <div class="empty-state">
        <div class="empty-icon">↗</div>
        <h3>No orders just yet.</h3>
        <p>Your next sale could be just around the corner.</p>
      </div>
    <% end %>
  </section>

  <footer class="dashboard-footer">
    <div class="footer-brand">loopedt<span>.</span></div>

    <%= link_to "← Back to marketplace", listings_path %>
  </footer>

</div>
