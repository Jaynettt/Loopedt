
<style>
  :root {
    --loop-green: #244e3b;
    --loop-dark: #193a2b;
    --loop-lime: #d9f36a;
    --loop-yellow: #ffe58a;
    --loop-orange: #ff9866;
    --loop-pink: #ffb9c9;
    --loop-cream: #fffdf5;
    --loop-ink: #25372c;
    --loop-muted: #7b877d;
    --loop-border: #e8ebdf;
  }

  .profile-page,
  .profile-page * {
    box-sizing: border-box;
  }

  .profile-page {
    width: 100%;
    min-height: 100vh;
    padding: 34px 24px 90px;
    background:
      radial-gradient(circle at 5% 5%, rgba(217, 243, 106, .13), transparent 24%),
      var(--loop-cream);
    color: var(--loop-ink);
    font-family: Arial, sans-serif;
  }

  .profile-container {
    max-width: 1180px;
    margin: 0 auto;
  }

  /* Back navigation */

  .profile-back {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 25px;
    color: var(--loop-green);
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    transition: gap .2s ease, color .2s ease;
  }

  .profile-back:hover {
    gap: 14px;
    color: var(--loop-dark);
  }

  /* Shop banner */

  .profile-header {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 30px;
    align-items: center;
    padding: 48px;
    margin-bottom: 55px;
    min-height: 315px;
    color: white;
    background: linear-gradient(125deg, var(--loop-dark), var(--loop-green));
    border-radius: 25px;
    box-shadow: 0 20px 45px rgba(25, 58, 43, .13);
  }

  .profile-header::before {
    content: "";
    position: absolute;
    z-index: -1;
    width: 370px;
    height: 370px;
    right: -75px;
    top: -185px;
    border: 1px solid rgba(217, 243, 106, .25);
    border-radius: 50%;
    box-shadow:
      0 0 0 35px rgba(217, 243, 106, .035),
      0 0 0 75px rgba(217, 243, 106, .025);
  }

  .profile-header::after {
    content: "";
    position: absolute;
    z-index: -1;
    width: 230px;
    height: 230px;
    right: 170px;
    bottom: -175px;
    background: var(--loop-lime);
    opacity: .09;
    border-radius: 50%;
  }

  .profile-header-content {
    max-width: 720px;
  }

  .profile-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 22px;
    color: var(--loop-lime);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .profile-eyebrow::before {
    content: "";
    width: 22px;
    height: 2px;
    background: var(--loop-lime);
  }

  .profile-shop-name {
    margin: 0 0 12px;
    color: white;
    font-size: clamp(32px, 5vw, 49px);
    line-height: 1.08;
    letter-spacing: -1.8px;
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .profile-username {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 22px;
    color: rgba(255, 255, 255, .68);
    font-size: 14px;
  }

  .verified-label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 11px;
    color: var(--loop-dark);
    background: var(--loop-lime);
    border-radius: 30px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .3px;
    text-transform: uppercase;
  }

  .verified-label::before {
    content: "✓";
    font-size: 12px;
  }

  .profile-description {
    max-width: 650px;
    margin: 0 0 20px;
    color: rgba(255, 255, 255, .83);
    font-size: 15px;
    line-height: 1.8;
  }

  .profile-location {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: rgba(255, 255, 255, .85);
    font-size: 13px;
  }

  .profile-location strong {
    color: var(--loop-lime);
  }

  /* Shop emblem */

  .profile-emblem {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 170px;
    height: 170px;
    flex-shrink: 0;
    border: 1px solid rgba(217, 243, 106, .55);
    border-radius: 50%;
    background: rgba(255, 255, 255, .06);
    box-shadow:
      0 0 0 13px rgba(255, 255, 255, .035),
      0 0 0 27px rgba(255, 255, 255, .025);
  }

  .profile-emblem span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 112px;
    height: 112px;
    color: var(--loop-dark);
    background: var(--loop-lime);
    border-radius: 50%;
    font-size: 47px;
    font-weight: 900;
    text-transform: uppercase;
    box-shadow: 0 12px 30px rgba(0, 0, 0, .15);
  }

  /* Shop statistics */

  .profile-stats {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: -86px 30px 60px;
  }

  .profile-stat {
    min-height: 112px;
    padding: 22px 25px;
    background: white;
    border: 1px solid var(--loop-border);
    border-radius: 17px;
    box-shadow: 0 12px 28px rgba(25, 58, 43, .055);
  }

  .profile-stat strong {
    display: block;
    margin-bottom: 7px;
    color: var(--loop-green);
    font-size: 27px;
    font-weight: 800;
    letter-spacing: -.8px;
  }

  .profile-stat span {
    color: var(--loop-muted);
    font-size: 12px;
    font-weight: 600;
  }

  /* Listings section */

  .seller-shop-section {
    padding: 0 5px;
  }

  .listings-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 25px;
  }

  .listings-heading h2 {
    margin: 0;
    color: var(--loop-dark);
    font-size: clamp(25px, 3vw, 32px);
    letter-spacing: -1px;
  }

  .listings-heading p {
    margin: 7px 0 0;
    color: var(--loop-muted);
    font-size: 13px;
  }

  .listings-count {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 14px;
    color: var(--loop-green);
    background: #eff5e7;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
  }

  .listings-count::before {
    content: "";
    width: 7px;
    height: 7px;
    background: #8caf48;
    border-radius: 50%;
  }

  /* Product cards */

  .listings-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
  }

  .product-card {
    display: block;
    min-width: 0;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background: white;
    border: 1px solid var(--loop-border);
    border-radius: 18px;
    box-shadow: 0 5px 18px rgba(25, 58, 43, .035);
    transition:
      transform .25s ease,
      box-shadow .25s ease,
      border-color .25s ease;
  }

  .product-card:hover {
    transform: translateY(-7px);
    border-color: rgba(36, 78, 59, .3);
    box-shadow: 0 18px 35px rgba(25, 58, 43, .11);
  }

  .product-media {
    position: relative;
    overflow: hidden;
    background: #f1f3e9;
  }

  .product-image {
    display: block;
    width: 100%;
    height: 285px;
    object-fit: cover;
    transition: transform .45s ease;
  }

  .product-card:hover .product-image {
    transform: scale(1.045);
  }

  .product-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 285px;
    color: var(--loop-muted);
    background:
      radial-gradient(circle at center, rgba(217, 243, 106, .2), transparent 65%),
      #f1f3e9;
    font-size: 13px;
    font-weight: 600;
  }

  .product-category {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    overflow: hidden;
    margin-bottom: 11px;
    padding: 6px 10px;
    color: var(--loop-green);
    background: #f0f5e7;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .7px;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .product-info {
    padding: 19px;
  }

  .product-info h3 {
    overflow: hidden;
    margin: 0 0 14px;
    color: var(--loop-dark);
    font-size: 16px;
    font-weight: 750;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .product-card:hover .product-info h3 {
    color: #426d48;
  }

  .product-price {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin: 0;
    padding-top: 13px;
    color: var(--loop-green);
    border-top: 1px solid #edf0e9;
    font-size: 19px;
    font-weight: 800;
  }

  .product-price::after {
    content: "↗";
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    color: var(--loop-dark);
    background: var(--loop-lime);
    border-radius: 50%;
    font-size: 15px;
    transition: transform .2s ease;
  }

  .product-card:hover .product-price::after {
    transform: translate(2px, -2px);
  }

  /* Empty state */

  .empty-listings {
    padding: 65px 25px;
    text-align: center;
    background: white;
    border: 1px dashed #d5dfce;
    border-radius: 20px;
  }

  .empty-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 65px;
    height: 65px;
    margin: 0 auto 18px;
    color: var(--loop-dark);
    background: var(--loop-lime);
    border-radius: 50%;
    font-size: 27px;
  }

  .empty-listings h3 {
    margin: 0 0 9px;
    color: var(--loop-dark);
    font-size: 21px;
  }

  .empty-listings p {
    margin: 0;
    color: var(--loop-muted);
    font-size: 13px;
    line-height: 1.7;
  }

  /* Responsive layout */

  @media (max-width: 850px) {
    .profile-header {
      padding: 38px;
    }

    .profile-emblem {
      width: 135px;
      height: 135px;
    }

    .profile-emblem span {
      width: 90px;
      height: 90px;
      font-size: 38px;
    }

    .listings-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .product-image,
    .product-placeholder {
      height: 245px;
    }
  }

  @media (max-width: 600px) {
    .profile-page {
      padding: 24px 15px 65px;
    }

    .profile-header {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 30px 24px 95px;
      margin-bottom: 35px;
      border-radius: 20px;
    }

    .profile-header-content {
      position: relative;
      z-index: 1;
    }

    .profile-shop-name {
      font-size: 35px;
    }

    .profile-emblem {
      position: absolute;
      right: 25px;
      bottom: 20px;
      width: 75px;
      height: 75px;
      box-shadow: none;
    }

    .profile-emblem span {
      width: 55px;
      height: 55px;
      font-size: 24px;
    }

    .profile-stats {
      gap: 9px;
      margin: -62px 9px 43px;
    }

    .profile-stat {
      min-height: 90px;
      padding: 15px 11px;
      border-radius: 12px;
    }

    .profile-stat strong {
      font-size: 21px;
    }

    .profile-stat span {
      font-size: 10px;
      line-height: 1.4;
    }

    .listings-heading {
      align-items: flex-start;
    }

    .listings-heading h2 {
      font-size: 25px;
    }

    .listings-heading p {
      font-size: 11px;
    }

    .listings-count {
      padding: 8px 10px;
      font-size: 10px;
    }

    .listings-grid {
      gap: 12px;
    }

    .product-image,
    .product-placeholder {
      height: 190px;
    }

    .product-info {
      padding: 12px;
    }

    .product-category {
      font-size: 9px;
      padding: 5px 7px;
    }

    .product-info h3 {
      font-size: 13px;
    }

    .product-price {
      font-size: 15px;
    }

    .product-price::after {
      width: 25px;
      height: 25px;
      font-size: 13px;
    }
  }

  @media (max-width: 380px) {
    .listings-grid {
      grid-template-columns: 1fr;
    }

    .product-image,
    .product-placeholder {
      height: 240px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-page *,
    .profile-page *::before,
    .profile-page *::after {
      transition: none !important;
      animation: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<div class="profile-page">
  <div class="profile-container">

    <%= link_to listings_path, class: "profile-back" do %>
      <span>←</span> Back to marketplace
    <% end %>

    <section class="profile-header">
      <div class="profile-header-content">
        <div class="profile-eyebrow">The Loopedt storefront</div>

        <h1 class="profile-shop-name">
          <%= @seller_application.shop_name %>
        </h1>

        <div class="profile-username">
          <span>@<%= @seller.username %></span>

          <% if @seller.verified? %>
            <span class="verified-label">Verified seller</span>
          <% end %>
        </div>

        <p class="profile-description">
          <%= @seller_application.description %>
        </p>

        <p class="profile-location">
          <span>⌖</span>
          <strong>Based in</strong>
          <%= @seller_application.location %>
        </p>
      </div>

      <div class="profile-emblem" aria-hidden="true">
        <span><%= @seller_application.shop_name.to_s.first&.upcase || "L" %></span>
      </div>
    </section>

    <div class="profile-stats">
      <div class="profile-stat">
        <strong><%= @listings.size %></strong>
        <span>Available items</span>
      </div>

      <div class="profile-stat">
        <strong><%= @completed_sales %></strong>
        <span>Completed sales</span>
      </div>

      <div class="profile-stat">
        <strong><%= @seller.created_at.strftime("%b %Y") %></strong>
        <span>Joined Loopedt</span>
      </div>
    </div>

    <section class="seller-shop-section">
      <div class="listings-heading">
        <div>
          <h2>Explore the shop</h2>
          <p>Find something you’ll love, straight from this seller.</p>
        </div>

        <span class="listings-count">
          <%= @listings.size %> items
        </span>
      </div>

      <% if @listings.any? %>
        <div class="listings-grid">
          <% @listings.each do |listing| %>
            <%= link_to listing_path(listing), class: "product-card" do %>

              <div class="product-media">
                <% if listing.images.attached? %>
                  <%= image_tag listing.images.first,
                      class: "product-image",
                      alt: listing.title %>
                <% else %>
                  <div class="product-placeholder">
                    No product photo
                  </div>
                <% end %>
              </div>

              <div class="product-info">
                <div class="product-category">
                  <%= listing.category&.name || "Pre-loved item" %>
                </div>

                <h3><%= listing.title %></h3>

                <p class="product-price">
                  <%= number_to_currency(
                    listing.price,
                    unit: "₦",
                    precision: 0
                  ) %>
                </p>
              </div>

            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="empty-listings">
          <div class="empty-icon">✳</div>
          <h3>Nothing on the racks just yet</h3>
          <p>
            This seller hasn't listed any available items at the moment.
            Check back soon for new finds.
          </p>
        </div>
      <% end %>
    </section>

  </div>
</div>
