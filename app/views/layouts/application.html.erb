<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Loopedt" %></title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="/buttons.css">
    <link rel="stylesheet" href="/responsive.css">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
   
    <%= javascript_include_tag "turbo", defer: true %>

    <style>
      :root {
        --loop-green: #244e3b;
        --loop-dark: #193a2b;
        --loop-lime: #d9f36a;
      }

      /* Turbo loading bar */
      .turbo-progress-bar {
        height: 3px;
        background: var(--loop-lime);
        box-shadow: 0 0 10px rgba(217, 243, 106, .65);
      }

      /* Page entrance */
      .page-transition {
        animation: loopedt-enter .35s cubic-bezier(.2, .7, .3, 1) both;
      }

      @keyframes loopedt-enter {
        from {
          opacity: 0;
          transform: translateY(9px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Interactive feedback */
      a, button, input[type="submit"] {
        -webkit-tap-highlight-color: transparent;
      }

      a, button, input[type="submit"] {
        transition:
          transform .2s ease,
          background-color .2s ease,
          color .2s ease,
          box-shadow .2s ease;
      }

      button:active,
      input[type="submit"]:active {
        transform: scale(.97);
      }

      a:focus-visible,
      button:focus-visible,
      input:focus-visible {
        outline: 2px solid var(--loop-lime);
        outline-offset: 3px;
      }

      @media (prefers-reduced-motion: reduce) {
        .page-transition {
          animation: none;
        }

        *, *::before, *::after {
          scroll-behavior: auto !important;
          transition-duration: .01ms !important;
        }
      }


    </style>
  </head>

  <body>
    <main class="page-transition" id="page-transition">
      <%= yield %>
    </main>
  </body>
</html>
